diff --git a/coding-agent/src/session/lane-model-switch.ts b/coding-agent/src/session/lane-model-switch.ts
--- a/coding-agent/src/session/lane-model-switch.ts
+++ b/coding-agent/src/session/lane-model-switch.ts
@@ -0,0 +1,191 @@
+import type { Agent, AgentMessage, CompletedTurnContext, ThinkingLevel } from "@gajae-code/agent-core";
+import type { Model, ToolResultMessage } from "@gajae-code/ai/core";
+
+export const PREWALK_PLAN = `STOP: In NEXT reply, before further exploration, write complete plan. Enough known; do not defer.
+
+Plan first; explicit, comprehensive; reference for remainder:
+- Remaining execution-order steps: exact files, symbols, commands, checks.
+- Risks, edge cases; verify each landed: specific commands, expected outputs. NEVER modify tests or verification assets to pass checks.
+- Already done, brief; prevent repetition.
+
+Thorough, concrete. Tools may verify details only after plan.
+
+Then, same reply and only after complete plan, use todo tool to capture 5–9 items: one per MEANINGFUL step; each concrete target + verification. Only code-changing or code-verifying steps; exclude reporting, bookkeeping, cleanup-ceremony, release-note items. Todo serves task, not reverse: reality/item conflict → fix actual problem, not checklist.
+
+Checkpoint, not final answer: after todo list, continue task; do not stop on plan alone.`;
+
+export const PREWALK_CONTINUE = "Continue task now; do not end turn here.";
+
+export const PREWALK_CHECKLIST = `Before task complete, verify:
+
+- Consistency: If a pattern, signature, or check changed in one place, grep every other call site or duplicate copy needing identical change. A fix at only some matching sites fails.
+- Scope: If diff exceeds the minimal issue-resolving change, confirm behavior unchanged outside the reported issue. Prefer the smallest correct diff over a broader rewrite.
+- Verification: Run the issue's full test module or file, not only the expected-to-flip test. A sibling-test-breaking change fails.
+
+Do not claim task complete until all three checks done.`;
+
+const PLAN_MESSAGE_TYPE = "prewalk-plan";
+const CONTINUE_MESSAGE_TYPE = "prewalk-continue";
+const CHECKLIST_MESSAGE_TYPE = "prewalk-checklist";
+
+/** Todo tool whose successful result opens the switch gate. */
+const TODO_TOOL = "todo_write";
+/**
+ * Tools an installed lane activates at session start, before the first model
+ * call. The plan nudge asks for `todo_write`; under tool discovery it is hidden
+ * until activated, and an inactive todo tool would leave the gate open.
+ */
+export const LANE_STARTUP_TOOLS: readonly string[] = [TODO_TOOL];
+/**
+ * Tools whose successful result arms the switch. A plain shell run never does:
+ * GJC 0.22.0 carries no tool-command dispatch provenance, so `bash` is not an
+ * action.
+ */
+const IMPLEMENTATION_TOOLS: ReadonlySet<string> = new Set(["edit", "write", "apply_patch", "ast_edit"]);
+
+/** Session-log metadata on the switch's model_change: the `lane_model_switch` marker. */
+export interface LaneModelSwitchMarker {
+	reason: string;
+	/** The executor role's configured thinking level, or null when the role sets none. */
+	thinkingLevel: ThinkingLevel | null;
+}
+
+/** The marker for a switch to `model` at `thinkingLevel`, as `provider/id[:level]`. */
+export function laneModelSwitchMarker(model: Model, thinkingLevel: ThinkingLevel | undefined): LaneModelSwitchMarker {
+	const selector = `${model.provider}/${model.id}${thinkingLevel === undefined ? "" : `:${thinkingLevel}`}`;
+	return { reason: `lane_model_switch ${selector}`, thinkingLevel: thinkingLevel ?? null };
+}
+
+/** Capabilities the lane switch borrows from its owning session. */
+export interface LaneModelSwitchHost {
+	agent: Agent;
+	/** Resolves the executor assignment, or undefined when the role is unset. */
+	resolveExecutor: () => Promise<{ model: Model; thinkingLevel?: ThinkingLevel } | undefined>;
+	/** Resolves once the completed turn's assistant message and tool results are durable. */
+	waitForPersistence: () => Promise<void>;
+	/**
+	 * Commits the session default model at the executor's thinking level and
+	 * records `marker` on the same model_change entry.
+	 */
+	commit: (model: Model, thinkingLevel: ThinkingLevel | undefined, marker: LaneModelSwitchMarker) => Promise<void>;
+	currentModel: () => Model | undefined;
+	currentThinkingLevel: () => ThinkingLevel | undefined;
+	activeToolNames: () => readonly string[];
+	/** Info-level report: plan nudge injected, same-model skip, switch landed. */
+	notify: (message: string) => void;
+	warn: (message: string) => void;
+}
+
+/**
+ * One lane, one switch. The planning model keeps the lane until its first
+ * completed turn with no qualifying action; from there a hidden plan nudge asks
+ * for a plan and a todo list, the continue nudge keeps the lane moving, and the
+ * first successful edit-type result after `todo_write` hands the lane to the
+ * executor. Edits are never blocked, and the switch is attempted at most once.
+ */
+export function installLaneModelSwitch(options: LaneModelSwitchHost & { enabled: boolean }): boolean {
+	if (!options.enabled) return false;
+	const { agent } = options;
+	let armed = true;
+	let planInjected = false;
+	let continuePending = false;
+	let todoSeen = false;
+
+	const steer = (customType: string, content: string): void => {
+		agent.steer({
+			role: "custom",
+			customType,
+			content,
+			display: false,
+			attribution: "agent",
+			timestamp: Date.now(),
+		});
+	};
+
+	const isPlanNudge = (message: AgentMessage): boolean =>
+		message.role === "custom" && message.customType === PLAN_MESSAGE_TYPE;
+
+	/** Retract the plan nudge everywhere a later model call could still read it. */
+	const scrubPlanNudge = (liveMessages: AgentMessage[]): void => {
+		for (let index = liveMessages.length - 1; index >= 0; index--) {
+			if (isPlanNudge(liveMessages[index])) liveMessages.splice(index, 1);
+		}
+		const stateMessages = agent.state.messages;
+		const filtered = stateMessages.filter(message => !isPlanNudge(message));
+		if (filtered.length !== stateMessages.length) {
+			// The rewrite drops the nudge from an append-only log too; without the
+			// history rewrite the cached prefix would keep serving it.
+			agent.replaceMessages(filtered, { historyRewrite: { reason: "lane_model_switch plan nudge scrub" } });
+		}
+		agent.removeQueuedMessages(isPlanNudge, "steering");
+	};
+
+	const implementationTool = (result: ToolResultMessage): string | undefined =>
+		!result.isError && IMPLEMENTATION_TOOLS.has(result.toolName) ? result.toolName : undefined;
+
+	const switchOnce = async (actionTool: string, turn: CompletedTurnContext): Promise<void> => {
+		// One-way: consume the arm before the attempt, so a same-model skip, a
+		// failure, or a successful switch all end the lane's planning phase.
+		armed = false;
+		try {
+			await options.waitForPersistence();
+			scrubPlanNudge(turn.messages);
+			const target = await options.resolveExecutor();
+			if (!target) {
+				options.warn("lane_model_switch executor assignment is missing; keeping the current model");
+				return;
+			}
+			const current = options.currentModel();
+			const sameModel = current?.provider === target.model.provider && current.id === target.model.id;
+			const sameThinking =
+				target.thinkingLevel === undefined || target.thinkingLevel === options.currentThinkingLevel();
+			if (sameModel && sameThinking) {
+				options.notify(
+					`lane_model_switch target ${target.model.provider}/${target.model.id} already matches the active model and thinking level; nothing to switch`,
+				);
+				return;
+			}
+			const marker = laneModelSwitchMarker(target.model, target.thinkingLevel);
+			await options.commit(target.model, target.thinkingLevel, marker);
+			steer(CHECKLIST_MESSAGE_TYPE, PREWALK_CHECKLIST);
+			options.notify(`${marker.reason}: switched after the first ${actionTool} result`);
+		} catch (error) {
+			options.warn(`lane_model_switch failed; keeping the current model: ${String(error)}`);
+		}
+	};
+
+	agent.onCompletedTurn = async turn => {
+		if (!armed || turn.message.role !== "assistant") return;
+		if (turn.toolResults.some(result => result.toolName === TODO_TOOL && !result.isError)) todoSeen = true;
+
+		if (planInjected && turn.toolResults.length > 0) {
+			continuePending = true;
+		} else if (continuePending) {
+			continuePending = false;
+			steer(CONTINUE_MESSAGE_TYPE, PREWALK_CONTINUE);
+		}
+
+		// The gate opens on a successful todo_write, or when the todo tool is not
+		// active at all. The session activates LANE_STARTUP_TOOLS before the first
+		// model call, so an inactive todo tool means the session has none (todo
+		// disabled). Before that, an edit is still just work: it never arms.
+		const todoGateOpen = todoSeen || !options.activeToolNames().includes(TODO_TOOL);
+		let actionTool: string | undefined;
+		if (todoGateOpen) {
+			for (const result of turn.toolResults) {
+				actionTool = implementationTool(result);
+				if (actionTool) break;
+			}
+		}
+		if (!actionTool) {
+			if (planInjected) return;
+			planInjected = true;
+			continuePending = true;
+			steer(PLAN_MESSAGE_TYPE, PREWALK_PLAN);
+			options.notify("lane_model_switch injected the plan nudge");
+			return;
+		}
+		await switchOnce(actionTool, turn);
+	};
+	return true;
+}
