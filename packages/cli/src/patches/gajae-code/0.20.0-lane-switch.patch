+export function withSdkHostTurnDeferral(bridge: ClientBridge | undefined): ClientBridge {
+	if (bridge?.deferAgentInitiatedTurns === true) return bridge;
+	return {
+		...bridge,
+		capabilities: bridge?.capabilities ?? {},
+		deferAgentInitiatedTurns: true,
+	};
+}
diff --git a/coding-agent/src/session/lane-model-switch.ts b/coding-agent/src/session/lane-model-switch.ts
new file mode 100644
index 0000000..2ad7012
--- /dev/null
+++ b/coding-agent/src/session/lane-model-switch.ts
@@ -0,0 +1,73 @@
+import type { Agent, AgentMessage, ThinkingLevel } from "@gajae-code/agent-core";
+import type { Model } from "@gajae-code/ai/core";
+
+export const LANE_PLAN = "Plan the change in text only. Do not call edit, write, apply_patch, or ast_edit yet.";
+export const LANE_CHECKLIST = "Implementation model is active. Complete the remaining edits. Do not change the model.";
+
+/** Session policy only. The agent owns tool execution and follow-up delivery. */
+export function installLaneModelSwitch(options: {
+	agent: Agent;
+	enabled: boolean;
+	resolveExecutor: () => Promise<{ model: Model; thinkingLevel?: ThinkingLevel } | undefined>;
+	record: (model: Model, thinkingLevel: ThinkingLevel | undefined) => Promise<void>;
+	activate: (model: Model, thinkingLevel: ThinkingLevel | undefined) => void;
+	warn: (message: string) => void;
+}): void {
+	if (!options.enabled) return;
+	const { agent } = options;
+	let todoSucceeded = false;
+	let editSucceeded = false;
+	let planSent = false;
+	let firstReply = true;
+	let finished = false;
+	const user = (text: string): AgentMessage => ({
+		role: "user",
+		content: [{ type: "text", text }],
+		timestamp: Date.now(),
+	});
+	agent.subscribe(event => {
+		if (finished) return;
+		if (event.type === "tool_execution_end" && !event.isError) {
+			if (event.toolName === "todo_write") todoSucceeded = true;
+			else if (todoSucceeded && ["edit", "write", "apply_patch", "ast_edit"].includes(event.toolName)) {
+				editSucceeded = true;
+			}
+		}
+		if (planSent && firstReply && event.type === "message_end" && event.message.role === "assistant") {
+			firstReply = false;
+			if (!event.message.content.some(part => part.type === "toolCall")) agent.followUp(user("Continue."));
+		}
+	});
+	agent.beforeModelCall = async messages => {
+		if (finished) return;
+		if (editSucceeded) {
+			// One attempt only, including a rejected record. Never switch on a failed write.
+			finished = true;
+			try {
+				const target = await options.resolveExecutor();
+				if (!target) {
+					options.warn("lane_model_switch executor assignment is missing; keeping the current model");
+					return;
+				}
+				await options.record(target.model, target.thinkingLevel);
+				options.activate(target.model, target.thinkingLevel);
+				// Replace the committed plan in the actual provider context, not a queued steer.
+				for (const message of messages) {
+					if (message.role !== "user" || typeof message.content === "string") continue;
+					for (const part of message.content) {
+						if (part.type === "text" && part.text === LANE_PLAN) part.text = "Planning phase is complete.";
+					}
+				}
+				return [user(LANE_CHECKLIST)];
+			} catch (error) {
+				options.warn(`lane_model_switch failed; keeping the current model: ${String(error)}`);
+				return;
+			}
+		}
+		if (!planSent) {
+			planSent = true;
+			// Commit once at the call boundary; replace its restriction after switching.
+			return [user(LANE_PLAN)];
+		}
+	};
+}
